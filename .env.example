SECRET_KEY=change-this-to-a-random-secret-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
TOKEN_EXPIRE_HOURS=8

# sudo password for the server user (lbb_admin).
# Used when USE_SUDO=true so the app can run nginx/systemctl commands.
# Keep this file on the server only — never commit it to git.
SUDO_PASSWORD=

# Nginx paths (defaults work for Ubuntu)
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_ACCESS_LOG=/var/log/nginx/access.log
NGINX_ERROR_LOG=/var/log/nginx/error.log
